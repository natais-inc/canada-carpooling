# ============================================
# Canada Carpooling — Environment Variables
# Copy to .env.local for local dev
# On Vercel: set these in Project Settings > Environment Variables
# ============================================

# --- DATABASE (Neon PostgreSQL) ---
# Get from: https://console.neon.tech → Connection Details
# Use the "pooled" connection string for serverless
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/canada_carpooling?sslmode=require"

# --- NEXTAUTH ---
# NEXTAUTH_URL is auto-set by Vercel — no need to configure
NEXTAUTH_SECRET=""  # Generate: openssl rand -base64 32

# --- GOOGLE OAUTH ---
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- STRIPE ---
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""  # From Stripe webhook endpoint config

# --- EMAIL (Resend) ---
# Get an API key from: https://resend.com/api-keys
# The sender domain in EMAIL_FROM must be VERIFIED in Resend (DNS records added).
# Without RESEND_API_KEY the app runs but silently skips sending (see src/lib/email.ts).
RESEND_API_KEY=""
EMAIL_FROM="CarpoolWork <no-reply@carpoolwork.ca>"
# Base URL used for links in emails (verification, invites). Falls back to https://carpoolwork.ca
NEXT_PUBLIC_APP_URL="https://carpoolwork.ca"

# --- VERIFF (Identity Verification) ---
VERIFF_API_KEY=""
VERIFF_SECRET_KEY=""
VERIFF_BASE_URL="https://stationapi.veriff.com/v1"

# --- FILE UPLOAD ---
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# --- DATA SECURITY ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=""
DATA_HASH_SALT=""

# --- CRON JOBS ---
# Secret to authenticate Vercel cron calls
# Generate: openssl rand -base64 32
CRON_SECRET=""

# --- NEON DIRECT CONNECTION (for migrations only) ---
# Use the "direct" (unpooled) connection string from Neon
# Required for: prisma migrate, prisma db push
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/canada_carpooling?sslmode=require"
