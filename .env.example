# ============================================
# CarpoolWork — Environment Variables
# Copy to .env.local for local dev
# On Vercel: set these in Project Settings > Environment Variables
# ============================================

# --- DATABASE (Neon PostgreSQL) ---
# Pooled connection string for serverless; DIRECT_DATABASE_URL = unpooled (migrations only).
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- NEXTAUTH ---
# NEXTAUTH_URL is auto-set by Vercel.
NEXTAUTH_SECRET=""  # Generate: openssl rand -base64 32

# --- GOOGLE OAUTH (optional; provider is only registered when both are set) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- EMAIL (Resend) ---
# The sender domain in EMAIL_FROM must be VERIFIED in Resend (DNS records added).
# Without RESEND_API_KEY the app runs but skips sending (see src/lib/email.ts).
RESEND_API_KEY=""
EMAIL_FROM="CarpoolWork <no-reply@carpoolwork.ca>"
NEXT_PUBLIC_APP_URL="https://carpoolwork.ca"

# --- DATA SECURITY ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_HASH_SALT=""

# --- CRON JOBS (vercel.json) ---
# Generate: openssl rand -base64 32 — required, cron routes refuse to run without it.
CRON_SECRET=""
